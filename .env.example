# Atlassian OAuth 2.0 (3LO)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
ATLASSIAN_CLOUD_ID=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Base64 string that decodes to exactly 32 bytes, e.g. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=

# MySQL 8.4 (README "Development"; users from scripts/mysql-bootstrap.sql, dev-only passwords).
# The app user runs web and worker; npm run migrate uses MIGRATE_DATABASE_URL (the owner) when it is set.
DATABASE_URL=mysql://techplanner_app:app-dev-password@localhost:3306/techplanner
MIGRATE_DATABASE_URL=mysql://techplanner_owner:owner-dev-password@localhost:3306/techplanner
# Optional grantee of the per-table grants written by migrations; default 'techplanner_app'@'%'
APP_DB_USER=
APP_BASE_URL=http://localhost:3000

# GitHub Copilot SDK / CLI
COPILOT_GITHUB_TOKEN=
# Optional
COPILOT_CLI_PATH=
FACILITATOR_MODEL=
EVALUATOR_MODEL=
CONTEXT_TOKEN_BUDGET=150000

# Confluence publish target
CONFLUENCE_SPACE_KEY=
CONFLUENCE_PARENT_PAGE_ID=
# Optional JSON: {"<JIRA_PROJECT_KEY>": {"spaceKey": "...", "parentPageId": "..."}}
CONFLUENCE_PROJECT_OVERRIDES=

# Optional downstream webhook; secret is required when URL is set
DOWNSTREAM_WEBHOOK_URL=
DOWNSTREAM_WEBHOOK_SECRET=

# Optional JSON object: section name -> positive number
SECTION_WEIGHTS=

# Optional bearer token enabling GET /metrics (Prometheus); /metrics returns 404 when unset
METRICS_TOKEN=

# Optional Azure DevOps code investigation (ADR-0016). ORG_URL, PROJECT and PAT go together.
# PAT scopes: Code (Read) only.
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
# Optional comma-separated repository allow-list; empty means every repository in the project
AZURE_DEVOPS_REPOSITORIES=
# Optional Code Search host override; empty derives it from ORG_URL (dev.azure.com -> almsearch.dev.azure.com)
AZURE_DEVOPS_SEARCH_URL=
