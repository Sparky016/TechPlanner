{
  "name": "tech-planner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "audit:verify": "tsx --env-file-if-exists=.env scripts/audit-verify.ts",
    "eval:llm": "tsx --env-file-if-exists=.env evals/run.ts",
    "perf": "tsx --env-file-if-exists=.env scripts/perf/run.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@github/copilot-sdk": "1.0.16",
    "@tailwindcss/postcss": "^4.3.3",
    "@uiw/react-codemirror": "^4.25.12",
    "ajv": "^8.20.0",
    "diff": "^9.0.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "pg-boss": "^12.36.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@xmldom/xmldom": "^0.8.15",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
