{
  "$comment": "FakeLlmClient scenarios for the E2E suite (LLM_FAKE_SCRIPT). The first rule whose kind matches and whose 'match' occurs in the run's last user message supplies the steps. Facilitator rules key on the facilitator's message; evaluator rules key on a marker planted in the Executive Summary. The unmatched evaluator run reports nothing, so every section is missing and the mandatory critical issues fire.",
  "rules": [
    {
      "kind": "facilitator",
      "match": "#stream",
      "steps": [
        {
          "type": "text-delta",
          "text": "Streaming the first part of the answer. "
        },
        {
          "type": "delay",
          "ms": 400
        },
        {
          "type": "text-delta",
          "text": "Now updating the Executive Summary. "
        },
        {
          "type": "delay",
          "ms": 400
        },
        {
          "type": "tool-call",
          "name": "apply_section_patch",
          "args": {
            "section": "Executive Summary",
            "op": "replace",
            "content": "E2E live patch: users export the report as CSV."
          }
        },
        {
          "type": "delay",
          "ms": 400
        },
        {
          "type": "text-delta",
          "text": "The Executive Summary is updated."
        },
        {
          "type": "done"
        }
      ]
    },
    {
      "kind": "facilitator",
      "match": "#precedence",
      "steps": [
        {
          "type": "text-delta",
          "text": "Reviewing the scope while you edit. "
        },
        {
          "type": "delay",
          "ms": 8000
        },
        {
          "type": "tool-call",
          "name": "apply_section_patch",
          "args": {
            "section": "Scope",
            "op": "replace",
            "content": "AI proposed scope: CSV export only."
          }
        },
        {
          "type": "text-delta",
          "text": "I proposed a Scope change."
        },
        {
          "type": "done"
        }
      ]
    },
    {
      "kind": "facilitator",
      "match": "#ask",
      "steps": [
        {
          "type": "text-delta",
          "text": "One question about limits."
        },
        {
          "type": "tool-call",
          "name": "ask_question",
          "args": {
            "text": "E2E question: what is the maximum export size?",
            "section": "Scope"
          }
        },
        {
          "type": "done"
        }
      ]
    },
    {
      "kind": "facilitator",
      "match": "#fill-ready",
      "steps": [
        {
          "type": "text-delta",
          "text": "Recording the agreed specification."
        },
        {
          "type": "tool-call",
          "name": "apply_section_patch",
          "args": {
            "section": "Executive Summary",
            "op": "replace",
            "content": "Agreed specification for CSV export. Marker: #ready"
          }
        },
        {
          "type": "done"
        }
      ]
    },
    {
      "kind": "facilitator",
      "match": "#fill-fixture",
      "steps": [
        {
          "type": "text-delta",
          "text": "Recording the readiness fixture."
        },
        {
          "type": "tool-call",
          "name": "apply_section_patch",
          "args": {
            "section": "Executive Summary",
            "op": "replace",
            "content": "Readiness fixture specification. Marker: #fixture"
          }
        },
        {
          "type": "done"
        }
      ]
    },
    {
      "kind": "facilitator",
      "steps": [
        {
          "type": "text-delta",
          "text": "Noted."
        },
        {
          "type": "done"
        }
      ]
    },
    {
      "kind": "evaluator",
      "match": "#ready",
      "steps": [
        {
          "type": "tool-call",
          "name": "report_section_status",
